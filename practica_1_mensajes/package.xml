<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>practica_1_mensajes</name>
  <version>1.0.0</version>
  <description>Mensajes propios: estado cinemático de las articulaciones del UR3e</description>
  <maintainer email="ignacio@todo.todo">ignacio</maintainer>
  <license>Apache-2.0</license>

  <!-- Los mensajes solo se pueden generar con CMake -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- EstadoCinematico.msg usa std_msgs/Header -->
  <depend>std_msgs</depend>

  <!-- Genera el código Python a partir de los .msg al compilar -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Necesario para usar los mensajes generados en ejecución -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Registra el paquete como paquete de interfaces de ROS 2 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Comprobaciones de estilo de ROS 2 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
